# PocketStudio local environment
# Copy to `.env` — never commit real keys or this file after filling secrets.

# PostgreSQL + pgvector (required). SQLite is not a supported runtime store.
# docker compose up -d postgres
DATABASE_URL=postgresql://pocketstudio:pocketstudio@127.0.0.1:5432/pocketstudio

# HMAC for sessions + AES key material for provider API keys (SHA-256 of this).
# Generate:  openssl rand -base64 32
AUTH_SECRET=change-me-in-local-dev

# Optional: seed an admin on first register if this email is not in the DB.
# If omitted, the first registered user becomes admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional overrides (defaults = <repo>/workspace and <repo>/templates/nextjs-basic)
# VIBEFLOW_WORKSPACE_ROOT=
# VIBEFLOW_TEMPLATE_ROOT=

# Agent chat transport (socket.io). Default 3003. Next is 3000.
# AGENT_PORT=3003

# AI providers and API keys are configured in the admin panel
# (Админ → Модели ИИ) or in user settings (Настройки ИИ / BYOK).
# Examples of base URLs:
#   OpenAI:              https://api.openai.com/v1
#   Anthropic:           https://api.anthropic.com
#   Groq:                https://api.groq.com/openai/v1
#   OpenRouter:          https://openrouter.ai/api/v1
#   llama.cpp / local:   http://127.0.0.1:8080/v1
#
# For RAG, assign an OpenAI-compatible embeddings model to tool `embeddings`
# (e.g. text-embedding-3-small, 1536 dimensions). Anthropic has no embeddings API.
