# PocketStudio local environment
# Copy to `.env` — never commit real keys.

DATABASE_URL=file:./db/custom.db
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI providers and API keys are configured in the admin panel
# (Админ → Модели ИИ) or in user settings (Настройки ИИ / BYOK).
# Examples of base URLs:
#   OpenAI:              https://api.openai.com/v1
#   Anthropic:           https://api.anthropic.com
#   Groq:                https://api.groq.com/openai/v1
#   OpenRouter:          https://openrouter.ai/api/v1
#   llama.cpp / local:   http://127.0.0.1:8080/v1
