// PocketStudio — unified platform schema (SQLite)
// Dual storage: project sources live on disk + git; platform data lives here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Users & Auth ───────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // 'client' | 'admin' (IDE modes are NOT roles)
  role         String   @default("client")
  avatarUrl    String?
  /// Первый запуск: тур onboarding пройден или пропущен.
  onboardingDone Boolean @default(false)
  /// Quest после онбординга: id первой заметки (proto1).
  questNoteId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notes         Note[]
  categories    Category[]
  tags          Tag[]
  projects      Project[]
  threads       Thread[]
  notifications Notification[]
  auditLogs     AuditLog[]
  mcpServers    McpServer[]
  aiProviders   AiProvider[]
  toolModels    UserToolModel[]
  skills        Skill[]
  offers        Offer[]
  payouts       Payout[]
  invitesCreated Invite[] @relation("InviteCreator")
}

// ─────────────────────────── Notebook ───────────────────────────

/// Dynamic user category — classifier picks existing or creates new ones.
model Category {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  // Tailwind-ish color key: emerald, amber, rose, sky, violet...
  color       String   @default("stone")
  // Lucide icon name
  icon        String   @default("lightbulb")
  description String?
  createdAt   DateTime @default(now())

  notes Note[]

  @@unique([userId, name])
  @@index([userId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  rawText   String?
  audioUrl  String?

  // 'pending' | 'processing' | 'processed' | 'error'
  status    String   @default("pending")

  transcription String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  favorite Boolean  @default(false)
  /// Напоминание (proto1 inbox): когда вернуть мысль в блокнот.
  remindAt DateTime?

  // 4-block analysis (filled by pipeline)
  positiveBlock   String?
  negativeBlock   String?
  finalBlock      String?
  recommendations String? // JSON array string
  analysisRaw     String?
  analyzedAt      DateTime?
  errorMessage    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags  NoteTag[]
  links NoteLink[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([userId, remindAt])
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("stone")
  createdAt DateTime @default(now())

  notes NoteTag[]

  @@unique([userId, name])
}

model NoteTag {
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}

// ─────────────────────────── Projects (sources on disk + git) ───────────────────────────

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // workspace/<id> on disk (null для контентных воркспейсов без кода)
  rootPath    String?
  // 'template' | 'github' | 'zip' | 'workspace' (контентный воркспейс)
  origin      String   @default("template")
  // 'film' | 'book' | 'music' | 'app' | 'universal' (Фаза A: тип воркспейса)
  type        String   @default("app")
  // Человекочитаемая стадия пайплайна («Монтаж») + её индекс (1-based).
  stage       String?
  stageIndex  Int?
  // 0–100, для прогресс-бара.
  progress    Int      @default(0)
  favorite    Boolean  @default(false)
  archived    Boolean  @default(false)
  remoteUrl   String?
  templateVersion String?
  lastBranch  String?
  lastCommit  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  threads   Thread[]
  noteLinks NoteLink[]
  documents Document[]
  entities  Entity[]
  artifacts Artifact[]
  findings  Finding[]
  dawProject DawProject?
  designDocs DesignDoc[]
  videoProject VideoProject?
  offers    Offer[]

  @@index([userId])
}

// ─────────────────────────── Documents (Фаза A) ───────────────────────────

/// Документ воркспейса: рукопись / спека / статья / сценарий.
model Document {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  // 'manuscript' | 'spec' | 'article' | 'script'
  kind        String   @default("manuscript")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections DocumentSection[]
  findings Finding[]

  @@index([projectId])
}

/// Глава / раздел документа с редактируемым текстом.
model DocumentSection {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title      String
  order      Int      @default(0)
  content    String   @default("")
  // 'draft' | 'done'
  status     String   @default("draft")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  revisions DocumentSectionRevision[]

  @@index([documentId, order])
}

/// Снапшот главы перед перезаписью: история версий и восстановление (PS-6).
model DocumentSectionRevision {
  id        String   @id @default(cuid())
  sectionId String
  section   DocumentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  /// Снимок текста главы на момент версии.
  content   String
  // 'manual' | 'ai' | 'restore' — откуда пришла новая правка поверх.
  source    String   @default("manual")
  /// Длительность текста версии (для превью «1 240 симв.»).
  size       Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sectionId, createdAt])
}

// ─────────────────── Entities — универсальная картотека (PS-3.2) ───────────────────

/// Сущность воркспейса: персонажи/лор книги ИЛИ пользователи/требования спеки.
model Entity {
  id          String   @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Идентификатор набора внутри воркспейса (напр. 'main').
  setId       String   @default("main")
  /// Название набора для UI («Хроники Долгой Зимы»).
  setName     String   @default("Сущности")
  // 'narrative' | 'product'
  domain      String   @default("narrative")
  // 'character' | 'location' | 'event' | 'item' | 'faction' | 'rule'
  // | 'user' | 'role' | 'requirement' | 'module' | 'integration'
  kind        String
  name        String
  short       String?
  description String
  /// JSON: [{label, value}]
  attributes  String   @default("[]")
  /// JSON: [string]
  tags        String   @default("[]")
  /// JSON: {kind: 'chapter'|'section', items: [string]}
  refs        String   @default("{\"kind\":\"chapter\",\"items\":[]}")
  /// JSON: {gradient, initials} — портрет-заглушка персонажа.
  portrait    String?
  /// URL сгенерированного портрета/иллюстрации (PS-6, персистентный).
  image       String?
  /// Промпт генерации портрета.
  imagePrompt String?
  favorite    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  linksFrom EntityLink[] @relation("linksFrom")
  linksTo   EntityLink[] @relation("linksTo")
  artifacts Artifact[]

  @@index([projectId, setId])
}

/// Связь между сущностями (родство/союз/конфликт/…).
model EntityLink {
  id     String @id @default(cuid())
  fromId String
  from   Entity @relation("linksFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     Entity @relation("linksTo", fields: [toId], references: [id], onDelete: Cascade)
  // 'related' | 'family' | 'ally' | 'conflict'
  kind   String @default("related")

  @@index([fromId])
  @@index([toId])
}

// ─────────────────────────── Artifacts (Фаза A/B) ───────────────────────────

/// Артефакт воркспейса: сгенерированная картинка, аудио, видео, файл.
model Artifact {
  id          String   @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // 'image' | 'audio' | 'video' | 'document' | 'file'
  type        String
  title       String
  description String?
  /// URL файла (напр. /gen/<id>.png) или data-url.
  url         String?
  /// Промпт генерации (для AI-артефактов).
  prompt      String?
  /// Привязка к сущности (портрет персонажа и т.п.).
  entityId    String?
  entity      Entity?  @relation(fields: [entityId], references: [id], onDelete: SetNull)
  /// Стадия пайплайна, к которой прицеплен артефакт в Обзоре.
  stage       String?
  /// JSON-мета (тонкость: длительность для аудио, размер и т.п.).
  meta        String?
  favorite    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, type])
}

// ─────────────────────────── DAW (Фаза C) ───────────────────────────

/// Состояние карманной DAW-студии воркспейса (Web Audio, треки в JSON).
model DawProject {
  id           String  @id @default(cuid())
  projectId    String  @unique
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bpm          Int     @default(112)
  /// Тактов по 16 шагов (16-е доли).
  bars         Int     @default(4)
  masterVolume Float   @default(0.85)
  /// Транспонирование в полутонах (-12..12).
  transpose    Int     @default(0)
  metronome    Boolean @default(false)
  /// JSON DawTrack[] — дорожки с паттернами (см. src/lib/daw-model.ts).
  tracks       String  @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─────────────────────────── MCP integrations (Фаза D) ───────────────────────────

/// Реестр MCP-серверов пользователя: каталог (лениво засеивается) + свои серверы.
/// builtin-строки (adapter) дают РЕАЛЬНЫЕ инструменты оркестратору в песочнице;
/// внешние (stdio/sse) — сохранённый конфиг для полной версии.
model McpServer {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Ключ каталога ('filesystem', 'fetch', 'playwright', 'github'…) или null для своего.
  catalogKey  String?
  name        String
  description String
  // 'dev' | 'content' | 'data'
  category    String   @default("dev")
  /// 'builtin' — адаптер песочницы | 'stdio' | 'sse'.
  transport   String   @default("stdio")
  /// JSON {command, args: string[], env: {}} для stdio | {url} для sse | {} для builtin.
  config      String   @default("{}")
  /// Ключ builtin-адаптера: 'filesystem' | 'fetch' | 'browser' (null для внешних).
  adapter     String?
  /// Внешний сервер: в песочнице конфиг сохраняется, инструменты недоступны.
  external    Boolean  @default(true)
  toolsCount  Int      @default(0)
  enabled     Boolean  @default(false)
  /// Пользовательский (не из каталога).
  own         Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, catalogKey])
  @@index([userId])
}

// ─────────────────── Findings — Аналитик (PS-3.2) ───────────────────

/// Находка Аналитика: противоречие / недосказанность / расхождение.
model Finding {
  id         String   @id @default(cuid())
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Область анализа: 'manuscript' | 'spec' | …
  scope      String   @default("manuscript")
  // 'contradiction' | 'omission' | 'inconsistency'
  type       String
  // 'info' | 'warning' | 'critical'
  severity   String   @default("warning")
  title      String
  quote      String?
  advice     String?
  /// Источник: «гл. 2» / «SRS-4.2 · FR-12».
  sourceRef  String?
  // 'open' | 'fixed' | 'dismissed'
  status     String   @default("open")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId, status])
}

/// Link between a note and a project (reference / context / proposal).
model NoteLink {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // 'reference' | 'context' | 'proposal'
  kind      String   @default("reference")
  createdAt DateTime @default(now())

  @@unique([noteId, projectId])
}

// ─────────────────────────── Chat (agent cockpit) ───────────────────────────

model Thread {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title     String   @default("Новый диалог")
  // 'ask' | 'plan' | 'act' | 'review'
  mode      String   @default("ask")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  runs     AgentRun[]
  tasks    Task[]

  @@index([userId, updatedAt])
}

/// Structured plan step produced by the agent in «План» mode (Stage 4c).
/// A new plan REPLACES the thread's task list; progress is tracked here
/// (agent complete_task tool + user checkbox toggles).
model Task {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// 1-based position in the plan.
  order     Int
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId, order])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  // 'user' | 'assistant' | 'system' | 'tool'
  role      String
  content   String
  toolName  String?
  toolArgs  String? // JSON string
  toolResult String?
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

// ─────────────────────────── Agent runs & events ───────────────────────────

model AgentRun {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  projectId String?
  // 'queued' | 'running' | 'completed' | 'error' | 'cancelled'
  status    String   @default("queued")
  mode      String   @default("ask")
  startedAt DateTime?
  finishedAt DateTime?
  error     String?
  createdAt DateTime @default(now())

  events AgentEvent[]

  @@index([threadId, createdAt])
}

/// Append-only event journal (OpenHands-style event stream).
model AgentEvent {
  id        String   @id @default(cuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq       Int
  // 'llm_start' | 'llm_end' | 'tool_call' | 'tool_result' | 'file_diff' | 'checkpoint' | 'plan_update' | 'subagent' | ...
  type      String
  data      String // JSON string
  createdAt DateTime @default(now())

  @@index([runId, seq])
}

// ─────────────────────────── Notifications ───────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'analysis_ready' | 'agent_done' | 'diff_pending' | 'system'
  type      String
  title     String
  body      String?
  entityId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ─────────────────────────── Admin / settings ───────────────────────────

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// LLM / media provider. `userId` null = platform (admin, proxied, markup-ready);
/// set = user BYOK. The server always holds the key and proxies requests.
model AiProvider {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'openai_compatible' | 'anthropic_compatible'
  kind   String
  name   String
  /// OpenAI: https://api.openai.com/v1 · Anthropic: https://api.anthropic.com
  baseUrl String
  /// AES-256-GCM encrypted (enc:v1:…). Never returned in full to clients.
  apiKey      String
  apiKeyLast4 String  @default("")
  enabled     Boolean @default(true)
  /// Platform only: end users may pick this provider as a proxied option.
  visibleToUsers   Boolean @default(true)
  /// Future billing: percent markup (20 = +20%) on platform providers.
  markupPercent    Float?
  /// Future billing: multiplier (1.2 = +20%). Applied if percent is unset.
  markupMultiplier Float?
  /// Optional extra HTTP headers as a JSON object.
  extraHeaders     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models AiModel[]

  @@index([userId, enabled])
  @@index([enabled, visibleToUsers])
}

model AiModel {
  id          String     @id @default(cuid())
  providerId  String
  provider    AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  /// Upstream id, e.g. gpt-4o-mini / claude-sonnet-4-5-20250929
  modelId     String
  displayName String
  capChat        Boolean @default(true)
  capImage       Boolean @default(false)
  capTts         Boolean @default(false)
  capAsr         Boolean @default(false)
  capEmbeddings  Boolean @default(false)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  toolDefaults  ToolModelDefault[]
  userOverrides UserToolModel[]

  @@unique([providerId, modelId])
  @@index([providerId, enabled])
}

/// Platform-level default model for a studio tool (admin-managed).
model ToolModelDefault {
  toolId    String   @id
  modelId   String
  model     AiModel  @relation(fields: [modelId], references: [id], onDelete: Restrict)
  updatedAt DateTime @updatedAt
}

/// Per-user override: null modelId = «Студия (по умолчанию)».
model UserToolModel {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolId    String
  modelId   String?
  model     AiModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, toolId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  meta      String? // JSON string
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// ─────────────────────────── Skills (фаза E / F1) ───────────────────────────

/// SKILL.md пользователя: builtin / созданный / импортированный / из магазина.
model Skill {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Ключ каталога/магазина или null для своего.
  catalogKey  String?
  name        String
  description String   @default("")
  version     String   @default("1.0")
  // 'builtin' | 'created' | 'imported' | 'store'
  source      String   @default("created")
  /// Тело SKILL.md (frontmatter + markdown).
  skillMd     String
  /// JSON string[]
  triggers    String   @default("[]")
  icon        String   @default("Wand2")
  enabled     Boolean  @default(true)
  purchased   Boolean  @default(false)
  usedCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, catalogKey])
  @@index([userId, enabled])
}

// ─────────────────────────── Monetization (F10) ───────────────────────────

/// Оффер публикации воркспейса: цена и статус оплаты.
model Offer {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priceCents  Int      @default(0)
  currency    String   @default("RUB")
  // 'draft' | 'listed' | 'paid' | 'archived'
  status      String   @default("draft")
  /// 'simulated' | 'live'
  paymentMode String   @default("simulated")
  providerRef String?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
  @@index([projectId])
}

model Payout {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents Int
  currency    String   @default("RUB")
  // 'pending' | 'paid' | 'failed'
  status      String   @default("pending")
  providerRef String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
}

// ─────────────────────────── Design docs (F5) ───────────────────────────

/// Документ дизайна: растр или макет, JSON слоёв/фреймов.
model DesignDoc {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String   @default("Холст")
  // 'raster' | 'layout'
  mode      String   @default("raster")
  /// JSON canvas (layers / frames).
  payload   String   @default("{}")
  /// Превью dataURL или /gen/…
  previewUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, mode])
}

// ─────────────────────────── Video NLE (F6) ───────────────────────────

/// Монтажный стол воркспейса (дорожки и клипы в JSON).
model VideoProject {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fps       Int      @default(24)
  /// JSON TimelineState — tracks/clips.
  timeline  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────── Invites (F12) ───────────────────────────

model Invite {
  id        String   @id @default(cuid())
  email     String
  // 'client' | 'admin'
  role      String   @default("client")
  token     String   @unique
  createdBy String
  creator   User     @relation("InviteCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  usedAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([email])
}
